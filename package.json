{
  "name": "zimba",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "web": "pnpm --filter web dev",
    "admin": "pnpm --filter admin dev",
    "generate": "pnpm --filter @workspace/db db:generate",
    "migrate": "pnpm --filter @workspace/db db:migrate",
    "db:reset": "pnpm --filter @workspace/db db:reset-data",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "bones:build": "pnpm --filter @workspace/ui exec boneyard build --out ./apps/web/bones",
    "check": "pnpm check:boundaries && turbo check:ci",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@workspace/typescript-config": "workspace:*",
    "turbo": "^2.9.18",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  }
}
